{
  "name": "spinningwheel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "backgrounds": "node scripts/backgrounds.mjs",
    "stickers": "node scripts/stickers.mjs",
    "quiz:regen": "node scripts/quiz-regenerate.mjs",
    "quiz:review": "node scripts/quiz-review.mjs",
    "bank:market": "node scripts/bank-market.mjs",
    "gym:equipment": "node scripts/gym-equipment.mjs",
    "gym:exercises": "node scripts/gym-exercises.mjs",
    "gym:demos": "node scripts/gym-demos.mjs",
    "gym:per-side": "node scripts/gym-per-side.mjs",
    "assets": "claude --model opus --allowedTools \"Bash,Read,Write,Edit,Glob,Grep\" -p \"$(cat scripts/optimize-assets.md)\"",
    "predev": "npm run backgrounds && npm run stickers",
    "dev": "vite",
    "prebuild": "npm run backgrounds && npm run stickers",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "optcg:scrape": "node scripts/optcg-scrape.mjs",
    "optcg:cards": "node scripts/optcg-catalog.mjs",
    "errors": "node scripts/errors.mjs",
    "gym:audit": "node scripts/gym-audit.mjs",
    "gym:audit:semantic": "node scripts/gym-audit-semantic.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite-plugin-pwa": "^1.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
