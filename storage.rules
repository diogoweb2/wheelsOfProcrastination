rules_version = '2';

// The only thing this project stores as files is Gym demo media (see
// BUSINESS_REQUIREMENTS.md §18l): a still and a looping animation per exercise,
// fetched from ExerciseDB by `npm run gym:demos` and re-hosted here so the app
// never depends on someone else's CDN.
//
// Same trust model as firestore.rules: the whole app is behind anonymous auth,
// so "signed in" is the bar. Everything outside gym/moves is denied outright —
// no other path should ever be writable.
service firebase.storage {
  match /b/{bucket}/o {
    match /gym/moves/{file} {
      allow read, write: if request.auth != null;
    }
    match /{everythingElse=**} {
      allow read, write: if false;
    }
  }
}
